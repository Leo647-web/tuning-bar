*{box-sizing:border-box}body{margin:0;background:#070707;color:#f5f5f5;font-family:Arial,Helvetica,sans-serif}.page{max-width:1050px;margin:auto;padding:20px}.hero{min-height:150px;display:flex;align-items:center;justify-content:center;gap:18px;padding:25px 10px;background:radial-gradient(circle,#351010 0,#0b0b0b 55%);border:1px solid #381010;border-radius:22px;margin-bottom:18px}.gear{font-size:52px;color:#e30000}.brand{font-size:clamp(38px,8vw,76px);font-weight:900;font-style:italic;letter-spacing:-3px}.brand b{color:#e00000}.sub{text-align:center;letter-spacing:5px;color:#aaa;font-size:12px;margin-top:3px}.card{background:linear-gradient(145deg,#151515,#0d0d0d);border:1px solid #303030;border-radius:18px;padding:20px;margin:18px 0;box-shadow:0 10px 30px #0008}.toolbar{display:flex;justify-content:space-between;gap:20px;align-items:center;border-top:3px solid #d90000}h1,h2{margin:0 0 7px}.toolbar p{margin:0;color:#999}.vehicle{display:flex;gap:8px}.vehicleBtn,.ghost,.print,.add{cursor:pointer;border:0;border-radius:10px;font-weight:800}.vehicleBtn{padding:13px;background:#252525;color:#bbb}.vehicleBtn.active{background:#e00000;color:#fff}.category{border:1px solid #2b2b2b;border-top:3px solid #e00000;border-radius:16px;margin:18px 0;overflow:hidden;background:#111}.categoryTitle{padding:16px 18px;background:linear-gradient(90deg,#250808,#121212);font-size:22px;font-weight:900}.grid{display:grid;grid-template-columns:repeat(2,1fr)}.item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-top:1px solid #252525}.item:nth-child(odd){border-right:1px solid #252525}.name{color:#eee}.price{color:#aaa;font-size:13px;margin-top:4px}.add{background:#eee;color:#000;padding:8px 11px;min-width:42px}.item.selected{background:#260909}.item.selected .add{background:#e00000;color:#fff}.invoiceHead{display:flex;justify-content:space-between;align-items:center;gap:10px}.invoiceHead span{color:#888}.ghost{background:#262626;color:#fff;padding:10px 13px}.lines{margin:16px 0}.line{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #242424;color:#ddd}.empty{color:#777;padding:10px 0}.discountBox label{display:block;color:#aaa;margin-bottom:7px}.discountBox select{width:100%;padding:13px;background:#1c1c1c;border:1px solid #333;border-radius:10px;color:#fff;font-size:16px}.totals{margin-top:15px}.totals div{display:flex;justify-content:space-between;padding:8px 0;color:#aaa}.totals .total{border-top:1px solid #444;margin-top:7px;padding-top:16px;color:#fff;font-size:23px}.print{width:100%;padding:15px;margin-top:15px;background:#e00000;color:#fff;font-size:16px}footer{text-align:center;color:#777;letter-spacing:5px;padding:18px;font-size:12px}@media(max-width:700px){.toolbar{flex-direction:column;align-items:stretch}.vehicle{display:grid;grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.item:nth-child(odd){border-right:0}.brand{font-size:42px}.hero{min-height:120px}}@media print{body{background:#fff;color:#000}.hero,.toolbar,#catalog{display:none!important}.card{box-shadow:none;border:0;background:#fff;color:#000}.invoice{margin:0}.ghost,.print,.discountBox{display:none}.line,.totals div{color:#000;border-color:#ddd}.totals .total{color:#000}footer{color:#000}}
